# Required for the Supermemory MCP connection.
SUPERMEMORY_API_KEY=sm_your_api_key_here

# Optional: scope all Supermemory calls to one Supermemory project.
# SUPERMEMORY_PROJECT_ID=your-project-id

# Not needed for local chatgpt() usage. Use this only after switching the
# deployed agent to a Vercel AI Gateway model.
# AI_GATEWAY_API_KEY=your-vercel-ai-gateway-key
