# Required for the Supermemory MCP connection.
SUPERMEMORY_API_KEY=sm_your_api_key_here

# Optional: scope all Supermemory calls to one Supermemory project.
# SUPERMEMORY_PROJECT_ID=your-project-id

# Optional locally. Vercel production uses its linked OIDC credential by default;
# set this only when you want to use an explicit AI Gateway key.
# AI_GATEWAY_API_KEY=your-vercel-ai-gateway-key

# Optional Telegram channel. Create the bot with @BotFather.
# TELEGRAM_BOT_TOKEN=123456:your-bot-token
# Use the username without the leading @. This enables group mention checks.
# TELEGRAM_BOT_USERNAME=your_bot
# Personal-only mode: your numeric Telegram user ID. Other users and groups are ignored.
# TELEGRAM_ALLOWED_USER_ID=123456789
# Use a random 1-256 character value when registering the webhook.
# TELEGRAM_WEBHOOK_SECRET_TOKEN=your-webhook-secret
